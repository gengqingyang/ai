# 复制成 .env 后填入实际值；程序启动时自动加载，不需要 source。
# 优先级：真实环境变量 > .env > 内置默认值。
# .env 已在 .gitignore 里，不要把填好的文件提交上去。

# ── 模型 ───────────────────────────────────────────────
# OpenAI 兼容协议走 /v1/chat/completions；需要回退 Claude 时改成 claude
LLM_PROVIDER=openai
# 走中转网关时填网关地址；OpenAI 模式会自动补齐末尾的 /v1
LLM_BASE_URL=
# 凭证二选一填一个即可，两种协议都会发送对应的鉴权头
LLM_AUTH_TOKEN=
# LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_MAX_TOKENS=4096
# 取值 [0,1]，不填则用服务端默认
# LLM_TEMPERATURE=

# ── Agent ──────────────────────────────────────────────
# ReAct 最大步数，防工具调用死循环
AGENT_MAX_STEP=12
# 保留的对话轮数（一轮 = 一问一答）
AGENT_HISTORY_TURNS=10
# 单次工具执行超时。只算真正下发那一段，等人审核的时间不计入。
# 可写 60 / 60s / 2m；节点上有慢命令（大目录扫描、抓包）就调大。
TOOL_TIMEOUT=60s

# ── 审核与审计 ─────────────────────────────────────────
# 变更提案的每次状态流转追加一行 JSON。留空表示不落盘，生产环境不要留空。
AUDIT_LOG=audit.log
# 审核人/操作人标识，写进审计日志、并随命令上报给 tunnel 对端。
# 不填则依次取 $USER / $USERNAME，都没有则记为 unknown-operator。
# OPERATOR=

# ── 运行日志 ───────────────────────────────────────────
# 模型调用、工具耗时、错误。默认落文件——打在终端会把对话冲得看不清。
# 填 stderr / - / console 则强制打终端；留空表示不记。
# 与 AUDIT_LOG 是两条独立的流：审计日志是「谁批准了什么」的凭证，不受级别过滤。
LOG_FILE=diagnostic.log
# debug / info / warn / error
LOG_LEVEL=info

# ── Tunnel ─────────────────────────────────────────────
# 节点命令下发接口，不填用 tools/tunnel.go 里的内置地址
# TUNNEL_API=

# 打开后打印工具调用等内部信息，并把 LOG_LEVEL 顺带调成 debug
DEBUG=false
